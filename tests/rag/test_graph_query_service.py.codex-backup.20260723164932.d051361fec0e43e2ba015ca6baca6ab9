def test_domain_stats_separates_hierarchy_spatial_and_semantic(monkeypatch):
    row = {
        "nodes": 8,
        "facts": 12,
        "relations": 15,
        "published_relations": 9,
        "semantic_relations": 4,
        "spatial_relations": 5,
        "hierarchy_relations": 6,
        "domain_name": "Domain",
        "last_sync_time": "2026-07-23T13:20:00Z",
    }
    session = FakeSession(lambda _query, _params: [row])
    monkeypatch.setattr(sync_service, "_neo4j_driver", lambda: FakeDriver(session))

    result = sync_service.neo4j_domain_stats("4")

    assert result["relations"] == 15
    assert result["published_relations"] == 9
    assert result["semantic_relations"] == 4
    assert result["spatial_relations"] == 5
    assert result["hierarchy_relations"] == 6
    query = session.calls[0][0]
    assert "r.relation_category = 'spatial'" in query
    assert "type(r) = 'PARENT_OF'" in query